<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+): cloud backup dan device-to-device transfer diatur
  terpisah dari android:allowBackup. Alasan pengecualian sama dengan
  backup_rules.xml — kunci Keystore tidak ikut berpindah.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
