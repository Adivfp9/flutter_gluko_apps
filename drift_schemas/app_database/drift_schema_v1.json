  "fixed_sql": [
    {
      "name": "user_profile",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_profile\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"name\" TEXT NULL, \"birth_year\" INTEGER NULL, \"diabetes_type\" TEXT NOT NULL DEFAULT 'unknown', \"unit\" TEXT NOT NULL DEFAULT 'mg_dl', \"preset\" TEXT NOT NULL DEFAULT 'general', \"onboarding_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_done\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1), CHECK (unit IN ('mg_dl','mmol_l')));"
        }
      ]
    },
    {
      "name": "target_ranges",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"target_ranges\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"reading_type\" TEXT NOT NULL UNIQUE, \"low_max\" INTEGER NOT NULL, \"normal_max\" INTEGER NOT NULL, \"warning_max\" INTEGER NOT NULL, \"critical_low\" INTEGER NOT NULL DEFAULT 54, \"critical_high\" INTEGER NOT NULL DEFAULT 300, \"updated_at\" INTEGER NOT NULL, CHECK (reading_type IN ('fasting','random','postprandial_2h')), CHECK (low_max < normal_max AND normal_max < warning_max));"
        }
      ]
    },
    {
      "name": "glucose_readings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"glucose_readings\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"reading_type\" TEXT NOT NULL, \"value_mg_dl\" INTEGER NOT NULL, \"measured_at\" INTEGER NOT NULL, \"tz_offset_min\" INTEGER NOT NULL, \"local_date\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"is_critical\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_critical\" IN (0, 1)), \"meal_context\" TEXT NULL, \"hours_after_meal\" REAL NULL, \"note\" TEXT NULL, \"source\" TEXT NOT NULL DEFAULT 'manual', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, CHECK (reading_type IN ('fasting','random','postprandial_2h')), CHECK (value_mg_dl BETWEEN 20 AND 600), CHECK (status IN ('low','normal','warning','high')), CHECK (note IS NULL OR length(note) <= 500));"
        }
      ]
    },
    {
      "name": "reading_symptoms",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reading_symptoms\" (\"reading_id\" INTEGER NOT NULL REFERENCES glucose_readings (id) ON DELETE CASCADE, \"symptom\" TEXT NOT NULL, PRIMARY KEY (\"reading_id\", \"symptom\"));"
        }
      ]
    },
    {
      "name": "reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminders\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"label\" TEXT NOT NULL, \"reading_type\" TEXT NULL, \"time_of_minutes\" INTEGER NOT NULL, \"days_mask\" INTEGER NOT NULL DEFAULT 127, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, CHECK (time_of_minutes BETWEEN 0 AND 1439), CHECK (days_mask BETWEEN 0 AND 127));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
  ]
}